{
  "accessibility_standards": {
    "subtitles": {
      "mandatory_for_dialogue": true,
      "max_reading_speed_cps": 21.0,
      "min_display_duration_seconds": 1.2,
      "max_line_length_characters": 42
    },
    "text_cards": {
      "min_display_duration_seconds": 1.5,
      "max_words_per_card": 8
    },
    "multimodal_redundancy": {
      "key_narrative_audio_must_have_subtitle_or_text_card": true
    }
  }
}
