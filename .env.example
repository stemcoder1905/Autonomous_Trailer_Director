# LLM Provider Configuration
LLM_PROVIDER=mock  # Options: mock, openai, anthropic, gemini
LLM_API_KEY=
LLM_MODEL=gpt-4o

# Cost & Safety Guardrails
MAX_LLM_CALLS=50
MAX_VISION_CALLS=20
MAX_MEDIA_PROCESSING_COST=10.0
MAX_TOTAL_COST=25.0

# Execution Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
