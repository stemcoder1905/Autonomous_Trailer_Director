  "dialogues": [
    {
      "dialogue_id": "dial_01",
      "character": "Raghu",
      "text": "Our looms have sung this rhythm for three centuries, Dev.",
      "timestamp_in": "00:00:15.000",
      "timestamp_out": "00:00:20.000",
      "tone": "reverent",
      "dialect_nuance": "Bhojpuri honorific phrasing"
    },
    {
      "dialogue_id": "dial_02",
      "character": "Vikram",
      "text": "Your antique traditions won't survive the next export quarter.",
      "timestamp_in": "00:02:15.000",
      "timestamp_out": "00:02:20.000",
      "tone": "arrogant",
      "dialect_nuance": "Standard corporate urban English-Hindi"
    },
    {
      "dialogue_id": "dial_03",
      "character": "Meera",
      "text": "Whatever happens to the mill, the family stands together.",
      "timestamp_in": "00:04:18.000",
      "timestamp_out": "00:04:23.000",
      "tone": "determined",
      "dialect_nuance": "Colloquial sibling solidarity"
    },
    {
      "dialogue_id": "dial_04",
      "character": "Dev",
      "text": "I'm not asking for your permission. I'm telling you what happens next.",
      "timestamp_in": "00:07:32.000",
      "timestamp_out": "00:07:37.000",
      "tone": "assertive",
      "dialect_nuance": "Bilingual youth assertion"
    },
    {
      "dialogue_id": "dial_05",
      "character": "Raghu",
      "text": "A weaver doesn't beg for fair price; his cloth commands it with honor.",
      "timestamp_in": "00:09:12.000",
      "timestamp_out": "00:09:18.000",
      "tone": "proud",
      "dialect_nuance": "Regional proverb"
    },
    {
      "dialogue_id": "dial_06",
      "character": "Dev",
      "text": "We can modernize the patterns without losing our soul.",
      "timestamp_in": "00:11:05.000",
      "timestamp_out": "00:11:10.000",
      "tone": "inspiring",
      "dialect_nuance": "Vernacular blend"
    },
    {
      "dialogue_id": "dial_07",
      "character": "Dev",
      "text": "If we bet everything, we either conquer the market or burn out.",
      "timestamp_in": "00:13:42.000",
      "timestamp_out": "00:13:47.000",
      "tone": "bold",
      "dialect_nuance": "Youth idiom"
    },
    {
      "dialogue_id": "dial_08",
      "character": "Dev",
      "text": "Let's see who blinks first.",
      "timestamp_in": "00:16:08.000",
      "timestamp_out": "00:16:12.000",
      "tone": "defiant",
      "dialect_nuance": "Sharp retort"
    },
    {
      "dialogue_id": "dial_09",
      "character": "Dev",
      "text": "The village loom works once more!",
      "timestamp_in": "00:18:22.000",
      "timestamp_out": "00:18:27.000",
      "tone": "exultant",
      "dialect_nuance": "Jubilant dialect exclamation"
    },
    {
      "dialogue_id": "dial_10",
      "character": "Harish",
      "text": "You thought Vikram acted alone? It was always my money, nephew.",
      "timestamp_in": "00:20:00.000",
      "timestamp_out": "00:20:06.000",
      "tone": "chilling",
      "dialect_nuance": "Betrayal reveal"
    },
    {
      "dialogue_id": "dial_11",
      "character": "Raghu",
      "text": "The royal seal cannot be rewritten by corporate signatures.",
      "timestamp_in": "00:21:05.000",
      "timestamp_out": "00:21:11.000",
      "tone": "triumphant",
      "dialect_nuance": "Formal heritage declaration"
    },
    {
      "dialogue_id": "dial_12",
      "character": "Dev",
      "text": "Tomorrow, the loom sings for the whole world.",
      "timestamp_in": "00:21:45.000",
      "timestamp_out": "00:21:50.000",
      "tone": "calm",
      "dialect_nuance": "Final hope"
    }
  ],
